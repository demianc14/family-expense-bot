# Copia este archivo a .env (ignorado por git) y completa los valores.
# Token que entrega @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=


# API key de Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Modelo a usar. flash-lite es el más rápido (2.8 s medidos) y el que menos
# cuota consume; los modelos grandes agotan el límite diario del plan gratuito.
GEMINI_MODELO=gemini-3.5-flash-lite

# Quién puede usar el bot y qué rol tiene, como id:rol separados por coma.
# Los roles son las personas de config/categories.yaml (papa, mama, hermana,
# demian). El rol es el valor por defecto de "de quién es el gasto".
# Vacío = nadie puede usar el bot. Para saber tu ID, escríbele a @userinfobot.
TELEGRAM_USUARIOS=
