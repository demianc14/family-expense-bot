# Copia este archivo a .env (ignorado por git) y completa los valores.
# Token que entrega @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=


# API key de Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# IDs de Telegram autorizados, separados por coma. Vacío = nadie puede usar el
# bot. Para saber el tuyo, escríbele a @userinfobot en Telegram.
TELEGRAM_ALLOWED_IDS=
