# Copia este archivo a n8n/.env (ignorado por git) y completa los valores.

# Clave con la que n8n cifra las credenciales en su base. Genérala una vez
# (openssl rand -hex 32) y no la cambies: sin ella no se pueden leer.
N8N_ENCRYPTION_KEY=

# URL pública HTTPS por la que Telegram llega a n8n (por ejemplo, la del túnel
# de cloudflared). Sin HTTPS, Telegram no entrega los mensajes y la confirmación
# cae a botones con enlace en vez de botones de un toque.
N8N_WEBHOOK_URL=

# Quién puede usar el bot y qué rol tiene, como id:rol separados por coma (mismo
# formato que la versión Python). Vacío = nadie puede usar el bot.
TELEGRAM_USUARIOS=

# Ingreso mensual de cada persona para el presupuesto 30/30/20/20, como
# rol:monto separados por coma (mismo formato que la versión Python).
INGRESOS_MENSUALES=

# Chat al que llegan los avisos de fallos no previstos (quien mantiene el bot).
TELEGRAM_ADMIN_CHAT_ID=

# Minutos que espera una confirmación antes de darla por vencida (defecto: 720).
MINUTOS_PARA_CONFIRMAR=
